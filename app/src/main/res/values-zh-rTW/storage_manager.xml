    <string name="storage_open_project_hint">點擊專案卡片以開啟專案根目錄檔案樹</string>
    <string name="storage_clean_project">清理專案執行環境</string>
    <string name="storage_clean_project_title">清理 %1$s 的執行環境資料？</string>
    <string name="storage_clean_project_message">將刪除 Studio 管理的該專案 Python/Node.js 執行工作區、相依套件、日誌與執行狀態，不刪除專案原始碼。下次執行前需要重新準備環境。</string>
    <string name="storage_clean_project_confirm">確認清理</string>
    <string name="storage_clean_project_done">專案執行環境資料已清理。</string>
    <string name="storage_section_orphans">未關聯執行環境資料</string>
    <string name="storage_unassociated_help">未關聯執行環境資料表示目前沒有匹配到 Studio 專案的 Python/Node.js 工作區或執行狀態；原始碼可能已刪除，也可能只是改名、移動或不在目前專案根目錄中。</string>
    <string name="storage_orphan_none">沒有發現未關聯執行環境資料。</string>
    <string name="storage_orphan_summary">共 %1$d 個未關聯執行環境 · 約可釋放 %2$s</string>
    <string name="storage_orphan_env">未關聯執行環境 %1$s · %2$s</string>
    <string name="storage_clean_orphan">刪除未關聯執行環境</string>
    <string name="storage_clean_orphan_title">刪除這個未關聯執行環境？</string>
    <string name="storage_clean_orphan_message">將刪除 %1$s 對應的全部受管執行環境資料，包括 Python/Node.js 工作區與執行狀態。它目前沒有匹配的 Studio 專案；專案原始碼可能仍存在於其他位置。</string>
    <string name="storage_clean_orphan_done">未關聯執行環境資料已刪除。</string>
    <string name="storage_clean_all_orphans">一鍵清理全部未關聯執行環境</string>
    <string name="storage_clean_all_orphans_title">清理全部未關聯執行環境？</string>
    <string name="storage_clean_all_orphans_message">將刪除目前識別出的 %1$d 個未關聯執行環境資料集合，預計釋放約 %2$s。正常專案執行環境與專案原始碼不會刪除。原始碼可能只是改名、移動或不在目前專案根目錄；若任一未關聯執行環境仍有執行中的程序，操作會被阻止。</string>
    <string name="storage_clean_all_orphans_confirm">全部清理</string>
    <string name="storage_clean_all_orphans_done">全部未關聯執行環境已清理。</string>
    <string name="storage_orphan_runtime_in_use">至少一個未關聯執行環境仍有執行中的程序，無法刪除。請先停止對應程序並重新整理空間統計。</string>
    <string name="storage_section_shared_runtime">共享執行環境、工具鏈與快取</string>
    <string name="storage_clear_cache">清理 PRoot 下載快取</string>
    <string name="storage_clear_cache_title">清理 PRoot 下載快取？</string>
    <string name="storage_clear_cache_message">這會刪除 proot-distro 的下載/映像快取，不會刪除已安裝的 Ubuntu、專案執行環境資料或專案原始碼。未來重新安裝執行環境時可能需要重新下載。</string>
    <string name="storage_clear_cache_done">PRoot 下載快取已清理。</string>
    <string name="storage_clear_pip_cache">清理 pip 快取</string>
    <string name="storage_clear_pip_cache_title">清理 pip 下載/建置快取？</string>
    <string name="storage_clear_pip_cache_message">這只會刪除可重複下載的 pip 快取，不會刪除已安裝在專案 Python 虛擬環境中的相依套件。之後重建環境時可能需要重新下載。</string>
    <string name="storage_clear_pip_cache_done">pip 快取已清理。</string>
    <string name="storage_clear_npm_cache">清理 npm 快取</string>
    <string name="storage_clear_npm_cache_title">清理 npm 下載快取？</string>
    <string name="storage_clear_npm_cache_message">這只會刪除可重複下載的 npm 套件快取，不會刪除專案執行工作區中的 node_modules。之後重新準備 Node.js 環境時可能需要重新下載。</string>
    <string name="storage_clear_npm_cache_done">npm 快取已清理。</string>
    <string name="storage_clear_apt_cache">清理 APT 快取</string>
    <string name="storage_clear_apt_cache_title">清理 APT 軟體包快取？</string>
    <string name="storage_clear_apt_cache_message">這只會刪除已下載的 APT 軟體包快取，不會解除安裝 Python、Node.js 或其他已安裝的 Ubuntu 軟體包。</string>
    <string name="storage_clear_apt_cache_done">APT 快取已清理。</string>
    <string name="storage_clear_toolchains">清理共享受管工具鏈</string>
    <string name="storage_clear_toolchains_title">清理共享受管工具鏈？</string>
    <string name="storage_clear_toolchains_message">將刪除 Studio 下載並管理的共享受管工具鏈，例如受管 Node.js。專案原始碼與專案執行工作區不會刪除，但相關專案下次執行前可能需要重新準備環境。有專案正在執行時此操作會被阻止。</string>
    <string name="storage_clear_toolchains_done">共享受管工具鏈已清理。</string>
    <string name="storage_uninstall_ubuntu">解除安裝 Ubuntu 執行環境</string>
    <string name="storage_uninstall_title">解除安裝共享 Ubuntu 執行環境？</string>
    <string name="storage_uninstall_message">這會刪除 Ubuntu、系統層級執行環境、所有專案執行環境資料、共享工具鏈與執行環境快取。Android 共用儲存空間中的專案原始碼不會刪除。必須先停止所有專案。</string>
    <string name="storage_uninstall_confirm_title">最後確認</string>
    <string name="storage_uninstall_confirm_message">解除安裝後，所有依賴 Ubuntu 執行環境的專案再次執行前都需要重新安裝或準備執行環境。確定繼續嗎？</string>
    <string name="storage_uninstall_confirm">確認解除安裝</string>
    <string name="storage_uninstall_done">Ubuntu 執行環境已解除安裝；專案原始碼已保留。</string>
    <string name="storage_runtime_in_use">仍有專案正在執行，不能修改共享執行環境或受管工具鏈。請先停止所有專案。</string>
    <string name="storage_proot_missing">未偵測到 proot-distro，無法讀取執行環境空間。</string>
    <string name="storage_command_failed">操作失敗：%1$s</string>
    <string name="storage_command_sent">命令已送出，executionId = %1$d</string>
