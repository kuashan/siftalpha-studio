    <string name="storage_clean_project">清理项目运行环境</string>
    <string name="storage_clean_project_title">清理 %1$s 的运行环境数据？</string>
    <string name="storage_clean_project_message">将删除该项目由 Studio 管理的 Python/Node.js 运行工作区、依赖、日志与运行状态，不删除项目源码。下次运行前需要重新准备环境。</string>
    <string name="storage_clean_project_confirm">确认清理</string>
    <string name="storage_clean_project_done">项目运行环境数据已清理。</string>
    <string name="storage_section_orphans">未关联运行环境数据</string>
    <string name="storage_unassociated_help">未关联运行环境数据表示当前没有匹配到 Studio 项目的 Python/Node.js 工作区或运行状态；源码可能已删除，也可能只是改名、移动或不在当前项目根目录中。</string>
    <string name="storage_orphan_none">没有发现未关联运行环境数据。</string>
    <string name="storage_orphan_summary">共 %1$d 个未关联运行环境 · 可释放约 %2$s</string>
    <string name="storage_orphan_env">未关联运行环境 %1$s · %2$s</string>
    <string name="storage_clean_orphan">删除未关联运行环境</string>
    <string name="storage_clean_orphan_title">删除这个未关联运行环境？</string>
    <string name="storage_clean_orphan_message">将删除 %1$s 对应的全部受管运行环境数据，包括 Python/Node.js 工作区和状态数据。它当前没有匹配的 Studio 项目；项目源码可能仍存在于其他位置。</string>
    <string name="storage_clean_orphan_done">未关联运行环境数据已删除。</string>
    <string name="storage_clean_all_orphans">一键清理全部未关联运行环境</string>
    <string name="storage_clean_all_orphans_title">清理全部未关联运行环境？</string>
    <string name="storage_clean_all_orphans_message">将删除当前识别出的 %1$d 个未关联运行环境数据集合，预计释放约 %2$s。正常项目运行环境和项目源码不会删除。源码可能只是改名、移动或不在当前项目根目录；若任一未关联运行环境仍有运行进程，操作会被阻止。</string>
    <string name="storage_clean_all_orphans_confirm">清理全部</string>
    <string name="storage_clean_all_orphans_done">全部未关联运行环境已清理。</string>
    <string name="storage_orphan_runtime_in_use">至少一个未关联运行环境仍有运行进程，不能删除。请先停止对应进程并刷新空间统计。</string>
    <string name="storage_section_shared_runtime">共享运行环境、工具链与缓存</string>
    <string name="storage_clear_cache">清理 PRoot 下载缓存</string>
    <string name="storage_clear_cache_title">清理 PRoot 下载缓存？</string>
    <string name="storage_clear_cache_message">这会删除 proot-distro 下载/镜像缓存，不会删除已安装的 Ubuntu、项目运行环境数据或项目源码。以后重新安装运行环境时可能需要重新下载。</string>
    <string name="storage_clear_cache_done">PRoot 下载缓存已清理。</string>
    <string name="storage_clear_pip_cache">清理 pip 缓存</string>
    <string name="storage_clear_pip_cache_title">清理 pip 下载/构建缓存？</string>
    <string name="storage_clear_pip_cache_message">这只删除 pip 可重复下载的缓存，不会删除已经安装在项目 Python 虚拟环境中的依赖。以后重建环境时可能需要重新联网下载。</string>
    <string name="storage_clear_pip_cache_done">pip 缓存已清理。</string>
    <string name="storage_clear_npm_cache">清理 npm 缓存</string>
    <string name="storage_clear_npm_cache_title">清理 npm 下载缓存？</string>
    <string name="storage_clear_npm_cache_message">这只删除 npm 可重复下载的包缓存，不会删除项目运行工作区中的 node_modules。以后重新准备 Node.js 环境时可能需要重新联网下载。</string>
    <string name="storage_clear_npm_cache_done">npm 缓存已清理。</string>
    <string name="storage_clear_apt_cache">清理 APT 缓存</string>
    <string name="storage_clear_apt_cache_title">清理 APT 软件包缓存？</string>
    <string name="storage_clear_apt_cache_message">这只删除已经下载的 APT 软件包缓存，不会卸载 Python、Node.js 或其他已安装的 Ubuntu 软件包。</string>
    <string name="storage_clear_apt_cache_done">APT 缓存已清理。</string>
    <string name="storage_clear_toolchains">清理共享受管工具链</string>
    <string name="storage_clear_toolchains_title">清理共享受管工具链？</string>
    <string name="storage_clear_toolchains_message">将删除 Studio 下载并管理的共享受管工具链，例如受管 Node.js。项目源码和项目运行工作区不会删除，但相关项目下次运行前可能需要重新准备环境。有项目正在运行时此操作会被阻止。</string>
    <string name="storage_clear_toolchains_done">共享受管工具链已清理。</string>
    <string name="storage_uninstall_ubuntu">卸载 Ubuntu 运行环境</string>
    <string name="storage_uninstall_title">卸载共享 Ubuntu 运行环境？</string>
    <string name="storage_uninstall_message">这会删除 Ubuntu、系统级运行环境、所有项目运行环境数据、共享工具链与运行环境缓存。Android 共享存储中的项目源码不会删除。必须先停止所有项目。</string>
    <string name="storage_uninstall_confirm_title">最后确认</string>
    <string name="storage_uninstall_confirm_message">卸载后，所有依赖 Ubuntu 运行环境的项目再次运行前都需要重新安装或准备运行环境。确定继续吗？</string>
    <string name="storage_uninstall_confirm">确认卸载</string>
    <string name="storage_uninstall_done">Ubuntu 运行环境已卸载；项目源码已保留。</string>
    <string name="storage_runtime_in_use">仍有项目正在运行，不能修改共享运行环境或受管工具链。请先停止所有项目。</string>
    <string name="storage_proot_missing">未检测到 proot-distro，无法读取运行环境空间。</string>
